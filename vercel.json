{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|favicon.ico|manifest.json|logo.png|favicon.svg).*)",
      "destination": "/index.html"
    }
  ]
} 